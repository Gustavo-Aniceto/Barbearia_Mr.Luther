# =====================================================================
# MR.LUDER — variáveis de ambiente
# Copie para .env.local (desenvolvimento). Em produção, cadastre na Vercel:
# Project → Settings → Environment Variables. NUNCA faça commit de valores reais.
# Nenhuma destas variáveis usa o prefixo NEXT_PUBLIC_ (exceto a URL do site),
# então nenhuma credencial chega ao navegador.
# =====================================================================

# --- Neon PostgreSQL --------------------------------------------------
# Preenchidas automaticamente ao conectar o Neon pelo Vercel Marketplace (aba Storage).
# DATABASE_URL: conexão com pooler (-pooler no host) usada pelo servidor.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED: conexão direta, usada pelas migrations (scripts/migrate.mjs).
DATABASE_URL_UNPOOLED=postgresql://USUARIO:SENHA@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Neon Managed Better Auth -----------------------------------------
# Neon Console → projeto → Auth → habilitar; copie a "Auth URL".
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# Segredo para assinar o cache de sessão (32+ caracteres): openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Neon Object Storage (S3) -----------------------------------------
# Bucket privado + credencial com escopos storage:read e storage:write.
#   neon buckets create mrluder-media
#   neon credentials create --scope storage:read --scope storage:write
# AWS_ACCESS_KEY_ID = token_id ; AWS_SECRET_ACCESS_KEY = s3_secret_access_key (exibido uma única vez)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-2.us-east-1.aws.neon.tech
AWS_REGION=us-east-1
STORAGE_BUCKET=mrluder-media

# --- Aplicação ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://mrluder-barbearia.vercel.app
# Protege /api/cron/* (a Vercel envia "Authorization: Bearer $CRON_SECRET"): openssl rand -hex 32
CRON_SECRET=

# --- Pagamentos (opcional; deixar vazio até contratar o gateway) ------
PAYMENT_PROVIDER=
ASAAS_WEBHOOK_TOKEN=
MERCADOPAGO_ACCESS_TOKEN=

# --- Avisos ao cliente por e-mail e SMS (Brevo) — ver docs/NOTIFICACOES.md ---
# Chave da API (segredo: só na Vercel, marcada como Sensitive)
BREVO_API_KEY=
# Remetente de e-mail VERIFICADO no Brevo (ex.: contato@seudominio.com.br)
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_NAME=MR.LUDER Barbearia
# Opcional: para onde vão as respostas dos clientes
NOTIFY_REPLY_TO=
# Remetente do SMS: até 11 letras/números, sem espaço (ex.: MRLUDER). Deixe vazio para não enviar SMS.
NOTIFY_SMS_SENDER=

# --- Pagamentos online (Asaas) — ver docs/PAGAMENTOS.md ---
PAYMENT_PROVIDER=asaas
# Chave da API ($aact_prod_ produção / $aact_hmlg_ sandbox). Segredo: só na Vercel.
ASAAS_API_KEY=
# Token secreto do webhook (32+ caracteres aleatórios)
ASAAS_WEBHOOK_TOKEN=
